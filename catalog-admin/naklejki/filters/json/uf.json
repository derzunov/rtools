438\u0438 \u0441\u0443\u0432\u0435\u043d\u0438\u0440\u043e\u0432 \u0438 \u043f\u043e\u0434\u0430\u0440\u043a\u043e\u0432.","comment":"","html":"<h2>\u041f\u0440\u0435\u0438\u043c\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0423\u0424-\u043f\u0435\u0447\u0430\u0442\u0438 \u043d\u0430\u043a\u043b\u0435\u0435\u043a<\/h2>\r\n<p>\u0423\u0424 (\u0443\u043b\u044c\u0442\u0440\u0430\u0444\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u0430\u044f) \u043f\u0435\u0447\u0430\u0442\u044c \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u0441\u0442\u0430\u043b\u0430 \u043f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u044b\u043c \u043c\u0435\u0442\u043e\u0434\u043e\u043c \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u043a\u0440\u0430\u0441\u043e\u0447\u043d\u044b\u0445 \r\n\u0438 \u0434\u043e\u043b\u0433\u043e\u0432\u0435\u0447\u043d\u044b\u0445 \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0445 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u0445:<\/p>\r\n<ul>\r\n\t<li>\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0431\u0440\u0435\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f. \u0421\u0430\u043c\u043e\u0435 \u0431\u044b\u0441\u0442\u0440\u043e\u0435 \u0431\u0440\u0435\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0423\u0424 \u0414\u0422\u0424 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0430\u043c\u0438.<\/li>\r\n\t<li>\u0413\u0438\u0431\u043a\u043e\u0441\u0442\u044c \u0432 \u0434\u0438\u0437\u0430\u0439\u043d\u0435. \u0423\u0424-\u043f\u0435\u0447\u0430\u0442\u044c \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0432\u043e\u043f\u043b\u043e\u0442\u0438\u0442\u044c \u0441\u0430\u043c\u044b\u0435 \u0440\u0430\u0437\u043d\u043e\u043e\u0431\u0440\u0430\u0437\u043d\u044b\u0435 \u0438\u0434\u0435\u0438 \r\n\t\u0432 \u0434\u0438\u0437\u0430\u0439\u043d\u0435 \u043d\u0430\u043a\u043b\u0435\u0435\u043a.<\/li>\r\n\t<li>\u0423\u0424 \u043f\u0435\u0447\u0430\u0442\u044c \u0431\u0435\u043b\u044b\u043c \u0446\u0432\u0435\u0442\u043e\u043c. <\/li>\r\n\t<li>\u041f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u044b\u0435 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u0441 \u0423\u0424-\u043f\u0435\u0447\u0430\u0442\u044c\u044e <\/li>\r\n\t<li>\u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044e \u0423\u0424-\u043f\u0438\u0433\u043c\u0435\u043d\u0442\u043e\u0432, \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u0438\u043c\u0435\u044e\u0442 \u044f\u0440\u043a\u0438\u0435 \u0438 \u043d\u0430\u0441\u044b\u0449\u0435\u043d\u043d\u044b\u0435 \r\n\t\u0446\u0432\u0435\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043d\u0435 \u0432\u044b\u0433\u043e\u0440\u0430\u044e\u0442. <\/li>\r\n\t<li>\u0423\u0424-\u0447\u0435\u0440\u043d\u0438\u043b\u0430, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u044b\u0435 \u0432 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0435 \u0423\u0424-\u043f\u0435\u0447\u0430\u0442\u0438, \u043d\u0435 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442 \u0440\u0430\u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0435\u043b\u0435\u0439 \r\n\t\u0438 \u0434\u0440\u0443\u0433\u0438\u0445 \u043e\u043f\u0430\u0441\u043d\u044b\u0445 \u0445\u0438\u043c\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432.<\/li>\r\n\t<li>\u0421\u0440\u043e\u0447\u043d\u0430\u044f \u043f\u0435\u0447\u0430\u0442\u044c. \u041d\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0432\u0440\u0435\u043c\u044f \u0434\u043b\u044f \u0441\u0443\u0448\u043a\u0438 \u043d\u0430\u043a\u043b\u0435\u0435\u043a. <\/li>\r\n<\/ul>\r\n<h2>\u0411\u0440\u0435\u043d\u0434\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0430\u043c\u0438 \u0423\u0424 \u0414\u0422\u0424<\/h2>\r\n<p>\u0423\u0424-\u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u2014 \u044d\u0442\u043e \u0441\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0438 \u0441\u0442\u0438\u043b\u044c\u043d\u044b\u0439 \u0441\u043f\u043e\u0441\u043e\u0431 \u0443\u043a\u0440\u0430\u0441\u0438\u0442\u044c \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u0438 \r\n\u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438. \u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0434\u0435\u043a\u043e\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0441 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u0423\u0424 \u0414\u0422\u0424 \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \r\n\u0431\u0435\u0437\u0433\u0440\u0430\u043d\u0438\u0447\u043d\u044b. \u041f\u0435\u0440\u0435\u043d\u043e\u0441 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u043d\u0430 \u0438\u0437\u0434\u0435\u043b\u0438\u0435 \u043e\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0437\u0430 \u043f\u0430\u0440\u0443 \u0441\u0435\u043a\u0443\u043d\u0434, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \r\n\u0423\u0424 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u0431\u044b\u0442\u044c \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u044b \u043d\u0430 \u0440\u0430\u0437\u043b\u0438\u0447\u043d\u044b\u0435 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u0438, \u0442\u0430\u043a\u0438\u0435 \u043a\u0430\u043a \u043f\u043b\u0430\u0441\u0442\u0438\u043a, \u0441\u0442\u0435\u043a\u043b\u043e, \r\n\u043c\u0435\u0442\u0430\u043b\u043b, \u0434\u0435\u0440\u0435\u0432\u043e \u0438 \u043c\u043d\u043e\u0433\u043e\u0435 \u0434\u0440\u0443\u0433\u043e\u0435.<\/p>\r\n<h2>\u041f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u0423\u0424-\u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u0437\u0430\u043a\u0430\u0437<\/h2>\r\n<p>\u041d\u0430\u0448\u0430 \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0438\u0437\u0433\u043e\u0442\u0430\u0432\u043b\u0438\u0432\u0430\u0442\u044c \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u0438\u0437 \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u043e\u0439 \u043f\u043b\u0451\u043d\u043a\u0438 \u0441 \u0423\u0424-\u043f\u0435\u0447\u0430\u0442\u044c\u044e.<\/p>\r\n<h2>\u0421\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043f\u0435\u0447\u0430\u0442\u0438 \u0423\u0424-\u043d\u0430\u043a\u043b\u0435\u0435\u043a<\/h2>\r\n<p>\u0417\u0430\u043a\u0430\u0437\u0430\u0442\u044c \u0443\u0444-\u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u043b\u044e\u0431\u043e\u0433\u043e \u0442\u0438\u0440\u0430\u0436\u0430 \u043c\u043e\u0436\u043d\u043e \u0432 \u043d\u0430\u0448\u0435\u0439 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u0438. \u0421\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u0423\u0424 \u043f\u0435\u0447\u0430\u0442\u0438 \r\n\u043d\u0430\u043a\u043b\u0435\u0435\u043a \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0442\u0438\u043f\u0430 \u043f\u043b\u0435\u043d\u043a\u0438 \u0438 \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u043d\u0430\u043a\u043b\u0435\u0435\u043a. \u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043f\u0435\u0447\u0430\u0442\u0438 \u0423\u0424 \r\n\u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u043d\u0430\u0448\u0435\u043c \u0441\u0430\u0439\u0442\u0435 \u0438\u043b\u0438 \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u0435 \u0446\u0435\u043d\u0443 \u0443 \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u0430. <\/p>","temporary":""}