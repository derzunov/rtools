\u0435\u0439\u043a\u0438 \u043d\u0430 \u043f\u043e\u043b \u043d\u0435 \u0431\u043e\u044f\u0442\u0441\u044f \u0438\u0441\u0442\u0438\u0440\u0430\u043d\u0438\u044f, \u0432\u044b\u0441\u043e\u043a\u043e\u0439 \u0432\u043b\u0430\u0436\u043d\u043e\u0441\u0442\u0438 \u0438 \u0432\u043e\u0434\u044b:<\/p>\r\n<ul>\r\n\t<li>\u041e\u0441\u043d\u043e\u0432\u0430 - \u0432\u0438\u043d\u0438\u043b\u043e\u0432\u0430\u044f \u043f\u043b\u0435\u043d\u043a\u0430. \u0426\u0432\u0435\u0442\u043d\u0430\u044f \u0438\u043b\u0438 \u0431\u0435\u043b\u0430\u044f \u0441 \u0448\u0438\u0440\u043e\u043a\u043e\u0444\u043e\u0440\u043c\u0430\u0442\u043d\u043e\u0439 \u043f\u0435\u0447\u0430\u0442\u044c\u044e. \r\n\t\u041f\u043b\u0451\u043d\u043e\u0447\u043d\u0430\u044f \u043e\u0441\u043d\u043e\u0432\u0430 \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u0430 \u043d\u0430 \u0431\u0443\u043c\u0430\u0436\u043d\u0443\u044e \u043f\u043e\u0434\u043b\u043e\u0436\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u043f\u043e\u043a\u0440\u044b\u0442\u0430 \u0441\u0438\u043b\u0438\u043a\u043e\u043d\u043e\u043c.\r\n\t<\/li>\r\n\t<li>\u0427\u0442\u043e\u0431\u044b \u043d\u0430\u043f\u043e\u043b\u044c\u043d\u0430\u044f \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0430 \u0441\u043b\u0443\u0436\u0438\u043b\u0430 \u0434\u043e\u043b\u0433\u043e, \u0435\u0435 \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u044e\u0442 \u043f\u0440\u043e\u0447\u043d\u044b\u043c \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u044b\u043c \r\n\t\u043b\u0430\u043c\u0438\u043d\u0430\u0442\u043e\u043c \u0438\u0437 \u0441\u043f\u0435\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u0441\u0442\u0438\u043a\u0430. \u041e\u0442 \u0435\u0433\u043e \u0441\u0432\u043e\u0439\u0441\u0442\u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u0441\u0440\u043e\u043a \u0441\u043b\u0443\u0436\u0431\u044b \u043d\u0430\u043a\u043b\u0435\u0435\u043a \r\n\t\u043d\u0430 \u043f\u043e\u043b. \u0427\u0442\u043e\u0431\u044b \u044d\u0444\u0444\u0435\u043a\u0442\u0438\u0432\u043d\u0435\u0439 \u0437\u0430\u0449\u0438\u0442\u0438\u0442\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435, \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u0442\u0441\u044f \u0434\u0435\u043b\u0430\u0442\u044c \u0440\u0430\u0437\u043c\u0435\u0440 \r\n\t\u043b\u0430\u043c\u0438\u043d\u0430\u0442\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u0430 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043d\u0430 1-2 \u0441\u0430\u043d\u0442\u0438\u043c\u0435\u0442\u0440\u0430. <\/li>\r\n<\/ul>\r\n<h2>\u041f\u0435\u0447\u0430\u0442\u044c \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u043f\u043e\u043b<\/h2>\r\n<p>\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0441\u043f\u043e\u0441\u043e\u0431\u044b \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430 \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u043f\u043e\u043b:<\/p>\r\n<ul>\r\n\t<li>\u0428\u0438\u0440\u043e\u043a\u043e\u0444\u043e\u0440\u043c\u0430\u0442\u043d\u0430\u044f \u043f\u0435\u0447\u0430\u0442\u044c \u043d\u0430 \u0431\u0435\u043b\u043e\u0439 \u0432\u0438\u043d\u0438\u043b\u043e\u0432\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u0435. \u042d\u0442\u043e \u043d\u0430\u0438\u0431\u043e\u043b\u0435\u0435 \u044d\u043a\u043e\u043d\u043e\u043c\u0438\u0447\u043d\u044b\u0439 \r\n\t\u0441\u043f\u043e\u0441\u043e\u0431, \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u043f\u0435\u0447\u0430\u0442\u0438 \u043d\u0430\u043a\u043b\u0435\u0435\u043a, \u044d\u0442\u0438\u043a\u0435\u0442\u043e\u043a, \u0441\u0442\u0438\u043a\u0435\u0440\u043e\u0432, \u0434\u0435\u043a\u043e\u0440\u0430, \u0440\u0435\u043a\u043b\u0430\u043c\u044b.<\/li>\r\n\t<li>\u041f\u043b\u043e\u0442\u0442\u0435\u0440\u043d\u0430\u044f \u0440\u0435\u0437\u043a\u0430 - \u0434\u043b\u044f \u0430\u043f\u043f\u043b\u0438\u043a\u0430\u0446\u0438\u0438 \u0446\u0432\u0435\u0442\u043d\u044b\u043c\u0438 \u043f\u043b\u0435\u043d\u043a\u0430\u043c\u0438 \u043f\u043e \u043f\u043e\u043b\u0443, \u0440\u043e\u0432\u043d\u044b\u043c \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044f\u043c \r\n\t\u0438 \u0442.\u0434.<\/li>\r\n<\/ul>\r\n<p>\u041f\u0435\u0447\u0430\u0442\u0430\u0435\u043c \u0441 \u0444\u0430\u0439\u043b\u043e\u0432 JPG, PNG, TIF, PDF, CDR, AI. \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043a\u0430\u0437\u0430\u0442\u044c \u043f\u0435\u0447\u0430\u0442\u044c \u043d\u0430\u043a\u043b\u0435\u0435\u043a \r\n\u043d\u0430 \u043f\u043e\u043b, \u044d\u0442\u0438\u043a\u0435\u0442\u043e\u043a \u0438 \u0441\u0442\u0438\u043a\u0435\u0440\u043e\u0432 \u043b\u044e\u0431\u043e\u0433\u043e \u0440\u0430\u0437\u043c\u0435\u0440\u0430 \u0438 \u0444\u043e\u0440\u043c\u044b, \u0441 \u043a\u043e\u0440\u043f\u043e\u0440\u0430\u0442\u0438\u0432\u043d\u043e\u0439 \u0441\u0438\u043c\u0432\u043e\u043b\u0438\u043a\u043e\u0439, \r\n\u043b\u043e\u0433\u043e\u0442\u0438\u043f\u043e\u043c, \u043a\u043e\u043d\u0442\u0430\u043a\u0442\u043d\u043e\u0439 \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0435\u0439 - \u044d\u0442\u043e \u043f\u043e\u0437\u0432\u043e\u043b\u0438\u0442 \u0432\u0430\u0448\u0435\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0432\u044b\u0434\u0435\u043b\u0438\u0442\u044c\u0441\u044f \u0441\u0440\u0435\u0434\u0438 \r\n\u043a\u043e\u043d\u043a\u0443\u0440\u0435\u043d\u0442\u043e\u0432. \u041e\u0431\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044c, \u043d\u0430\u0448\u0435 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u043e \u043f\u0435\u0447\u0430\u0442\u0430\u0435\u0442 \u0432\u0438\u043d\u0438\u043b\u043e\u0432\u044b\u0435 \u0438 \u0431\u0443\u043c\u0430\u0436\u043d\u044b\u0435 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \r\n\u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0441 2001 \u0433\u043e\u0434\u0430.<\/p>\r\n<h2>\u0414\u0438\u0437\u0430\u0439\u043d \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u043f\u043e\u043b<\/h2>\r\n<p>\u041e\u0441\u043e\u0431\u044b\u0445 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043d\u0438\u0439 \u043a \u0434\u0438\u0437\u0430\u0439\u043d\u0443 \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u043f\u043e\u043b \u043d\u0435\u0442, \u0437\u0430 \u0438\u0441\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c \u0441\u043b\u0443\u0447\u0430\u0435\u0432:<\/p>\r\n<ul>\r\n\t<li>\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435 \u0431\u0435\u043b\u043e\u0433\u043e \u0446\u0432\u0435\u0442\u0430 \u043f\u0440\u0438 \u043f\u0435\u0447\u0430\u0442\u0438 \u043d\u0430 \u043f\u0440\u043e\u0437\u0440\u0430\u0447\u043d\u043e\u0439 \u0438\u043b\u0438 \u0446\u0432\u0435\u0442\u043d\u043e\u0439 \u043e\u0441\u043d\u043e\u0432\u0435.\r\n\t<\/li>\r\n\t<li>\u0412 \u043c\u0430\u043a\u0435\u0442\u0430\u0445 \u0434\u043b\u044f \u043f\u043b\u043e\u0442\u0442\u0435\u0440\u043d\u043e\u0439 \u0440\u0435\u0437\u043a\u0438 \u043d\u0435 \u0434\u043e\u043b\u0436\u043d\u043e \u0431\u044b\u0442\u044c \u0442\u043e\u043d\u043a\u0438\u0445 \u0438 \u043e\u0441\u0442\u0440\u044b\u0445 \u0443\u0433\u043b\u043e\u0432, \u043c\u0438\u043d\u0438\u043c\u0430\u043b\u044c\u043d\u0430\u044f \r\n\t\u0448\u0438\u0440\u0438\u043d\u0430 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 - 1\u043c\u043c.<\/li>\r\n<\/ul>\r\n<h2>\u0421\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u043f\u043e\u043b<\/h2>\r\n<p>\u0426\u0435\u043d\u0430 \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u043f\u043e\u043b \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u0430 \u043e\u0441\u043d\u043e\u0432\u044b, \u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0438 \u043f\u0435\u0447\u0430\u0442\u0438, \u0444\u043e\u0440\u043c\u044b \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438, \r\n\u0442\u0438\u0440\u0430\u0436\u0430, \u0443\u0441\u043b\u0443\u0433 \u043f\u043e \u0434\u0438\u0437\u0430\u0439\u043d\u0443, \u0443\u043f\u0430\u043a\u043e\u0432\u043a\u0435, \u0434\u043e\u0441\u0442\u0430\u0432\u043a\u0435 \u043d\u0430\u043a\u043b\u0435\u0435\u043a.<\/p>\r\n<p>\u041d\u0430 \u043d\u0430\u0448\u0435\u043c \u0441\u0430\u0439\u0442\u0435 \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u0442\u044c \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0440\u0430\u0441\u0447\u0435\u0442 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u0438 \r\n\u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043b\u044e\u0431\u043e\u0439 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u043d\u0430 \u043f\u043e\u043b. \u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043d\u0430\u0436\u043c\u0438\u0442\u0435 \u043a\u043d\u043e\u043f\u043a\u0443 &quot;\u043d\u043e\u0432\u044b\u0439 \u0434\u0438\u0437\u0430\u0439\u043d&quot;, \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \r\n\u0441\u0432\u043e\u0439 \u043c\u0430\u043a\u0435\u0442, \u0443\u043a\u0430\u0436\u0438\u0442\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u043c\u044b\u0439 \u0440\u0430\u0437\u043c\u0435\u0440 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438, \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043f\u043e\u0441\u043e\u0431 \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438. \r\n\u0414\u043b\u044f \u0432\u0430\u0441 \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043d\u0430 \u0446\u0435\u043d\u0430 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u043d\u0430 \u043f\u043e\u043b \u0432 \u043d\u0430\u0448\u0435\u043c \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442-\u043c\u0430\u0433\u0430\u0437\u0438\u043d\u0435. \u0426\u0435\u043d\u0430 \u043d\u0430 \r\n\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0442\u0438\u0440\u0430\u0436 \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u043f\u043e\u043b \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u043c\u0435\u043d\u0435\u0434\u0436\u0435\u0440\u043e\u043c \u0438\u043d\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043b\u044c\u043d\u043e.<\/p>\r\n<h2>\u0417\u0430\u043a\u0430\u0437 \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u043f\u043e\u043b<\/h2>\r\n<p>\u041e\u0431\u0440\u0430\u0442\u0438\u0432\u0448\u0438\u0441\u044c \u0432 \u043d\u0430\u0448\u0443 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044e, \u0432\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0437\u0430\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u043d\u0430 \u043f\u043e\u043b, \u044d\u0442\u0438\u043a\u0435\u0442\u043a\u0438 \u0438 \u0441\u0442\u0438\u043a\u0435\u0440\u044b \r\n\u0432 \u043b\u044e\u0431\u043e\u043c \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0435, \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u044b \u043f\u0440\u043e\u0444\u0435\u0441\u0441\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e, \u0441 \u0432\u044b\u0441\u043e\u043a\u0438\u043c \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e\u043c \u0438\u0437\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d\u0438\u044f.<\/p>\r\n<p>\u0412\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u0440\u0430\u0437\u043c\u0435\u0449\u0435\u043d\u0438\u044f \u0437\u0430\u043a\u0430\u0437\u0430<\/p>\r\n<ul>\r\n\t<li>\u0412\u043e\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435\u0441\u044c \u0444\u043e\u0440\u043c\u043e\u0439 \u0434\u043b\u044f \u0440\u0430\u0437\u043c\u0435\u0449\u0435\u043d\u0438\u044f \u0437\u0430\u043a\u0430\u0437\u0430 \u0438 \u0440\u0430\u0437\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0435\u0433\u043e \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e\r\n\t<\/li>\r\n\t<li>\u041e\u0442\u043f\u0440\u0430\u0432\u044c\u0442\u0435 \u043d\u0430\u043c \u043d\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043d\u043d\u0443\u044e \u043f\u043e\u0447\u0442\u0443 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0441 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435\u043c \u0437\u0430\u043a\u0430\u0437\u0430, \u0430 \u0442\u0430\u043a \u0436\u0435 \r\n\t\u0438\u043c\u0435\u044e\u0449\u0438\u0435\u0441\u044f \u0443 \u0432\u0430\u0441 \u0444\u0430\u0439\u043b\u044b. \u041c\u0430\u043a\u0435\u0442, \u0440\u0438\u0441\u0443\u043d\u043e\u043a \u0438\u043b\u0438 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435, \u0444\u043e\u0442\u043e. \u041c\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u0438\u043c \u0440\u0430\u0441\u0447\u0435\u0442, \r\n\t\u043d\u0430\u043f\u0438\u0448\u0435\u043c \u0438\u043b\u0438 \u043f\u043e\u0437\u0432\u043e\u043d\u0438\u043c \u0432\u0430\u043c \u043f\u043e \u0442\u0435\u043b\u0435\u0444\u043e\u043d\u0443 \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u043e\u0431\u0449\u0438\u0442\u044c \u0446\u0435\u043d\u0443 \u0438 \u0432\u0440\u0435\u043c\u044f \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \r\n\t\u0432\u0430\u0448\u0435\u0433\u043e \u0437\u0430\u043a\u0430\u0437\u0430.<\/li>\r\n<\/ul>\r\n<h2>\u0413\u0430\u0440\u0430\u043d\u0442\u0438\u044f \u043d\u0430 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u043d\u0430 \u043f\u043e\u043b<\/h2>\r\n<p>\u0412\u044b\u0441\u043e\u043a\u043e\u0435 \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u043f\u0435\u0447\u0430\u0442\u0438 \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u043d\u0430 \u043f\u043e\u043b \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0435\u043c \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \r\n\u0440\u0430\u0441\u0445\u043e\u0434\u043d\u044b\u0445 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b\u043e\u0432 \u0438 \u043e\u0442\u043b\u0438\u0447\u043d\u044b\u043c \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435\u043c \u043f\u0435\u0447\u0430\u0442\u043d\u043e\u0433\u043e \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u0430 \u0442\u0438\u043f\u043e\u0433\u0440\u0430\u0444\u0438\u0438.<\/p>\r\n<ul>\r\n\t<li>\u041d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u0441 \u043b\u0430\u0437\u0435\u0440\u043d\u043e\u0439 \u043f\u0435\u0447\u0430\u0442\u044c\u044e \u043d\u0430 \u0431\u0443\u043c\u0430\u0433\u0435 \u0438\u043b\u0438 \u043f\u043b\u0435\u043d\u043a\u0435 \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u044b \u0434\u043b\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \r\n\t\u0432\u043d\u0443\u0442\u0440\u0438 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u0439, \u0441\u0440\u043e\u043a \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u043d\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d.<\/li>\r\n\t<li>\u041f\u0440\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u043d\u0430 \u0443\u043b\u0438\u0446\u0435, \u043d\u0430 \u0423\u0424 \u0438 \u0448\u0438\u0440\u043e\u043a\u043e\u0444\u043e\u0440\u043c\u0430\u0442\u043d\u0443\u044e \u043f\u0435\u0447\u0430\u0442\u044c \u043d\u0430 \u043f\u043b\u0435\u043d\u043a\u0435 \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \r\n\t\u0433\u0430\u0440\u0430\u043d\u0442\u0438\u044f 3 \u0433\u043e\u0434\u0430 \u043e\u0442 \u0432\u044b\u0433\u043e\u0440\u0430\u043d\u0438\u044f \u043d\u0430\u043a\u043b\u0435\u0435\u043a \u0438 \u0441\u0442\u0438\u043a\u0435\u0440\u043e\u0432 (\u0432\u043e\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432\u043b\u0430\u0433\u0438 \u0438 \u0441\u043e\u043b\u043d\u0435\u0447\u043d\u044b\u0445 \r\n\t\u043b\u0443\u0447\u0435\u0439).<\/li>\r\n\t<li>\u041d\u0430 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u0438\u0437 \u0446\u0432\u0435\u0442\u043d\u043e\u0439 \u043f\u043b\u0435\u043d\u043a\u0438 - \u0432 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0441 \u043c\u0430\u0440\u043a\u043e\u0439 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u043c\u043e\u0439 \u0432 \u0437\u0430\u043a\u0430\u0437\u0435 \r\n\t\u043f\u043b\u0435\u043d\u043a\u0438 (\u043e\u0442 1 \u0434\u043e 5 \u043b\u0435\u0442).<\/li>\r\n<\/ul>\r\n<h2>\u041d\u0430\u043a\u043b\u0435\u0439\u043a\u0430 \u043d\u0430 \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u043b\u0430<\/h2>\r\n<p>\u041d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u043b\u0435\u0433\u043a\u043e \u0438 \u043f\u0440\u043e\u0441\u0442\u043e \u043f\u0440\u0438\u043a\u043b\u0435\u0438\u0442\u044c \u043d\u0430 \u043f\u043e\u043b \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e:<\/p>\r\n<ul>\r\n\t<li>\u041f\u0435\u0440\u0435\u0434 \u043d\u0430\u043a\u043b\u0435\u0438\u0432\u0430\u043d\u0438\u0435\u043c \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438 \u043d\u0430 \u043f\u043e\u043b, \u043f\u043e\u0432\u0435\u0440\u0445\u043d\u043e\u0441\u0442\u044c \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u043a\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e \u043e\u0447\u0438\u0441\u0442\u0438\u0442\u044c \r\n\t\u0438 \u0436\u0435\u043b\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0431\u0435\u0437\u0436\u0438\u0440\u0438\u0442\u044c.<\/li>\r\n\t<li>\u041e\u0442\u043a\u043b\u0435\u0439\u0442\u0435 \u043e\u0434\u0438\u043d-\u0434\u0432\u0430 \u0441\u0430\u043d\u0442\u0438\u043c\u0435\u0442\u0440\u0430 \u0431\u0443\u043c\u0430\u0436\u043d\u043e\u0439 \u043f\u043e\u0434\u043b\u043e\u0436\u043a\u0438 \u043f\u043e \u043a\u043e\u0440\u043e\u0442\u043a\u043e\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u0435 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0438, \r\n\t\u0437\u0430\u0442\u0435\u043c \u044d\u0442\u0443 \u0447\u0430\u0441\u0442\u044c \u043f\u043e\u0434\u043b\u043e\u0436\u043a\u0438 \u0441\u043e\u0433\u043d\u0438\u0442\u0435.<\/li>\r\n\t<li>\u041f\u0440\u0438\u043b\u043e\u0436\u0438\u0442\u0435 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0443 \u043d\u0430 \u043f\u043e\u043b. \u0418 \u0433\u043b\u0430\u0432\u043d\u043e\u0435, \u043d\u0435 \u043f\u0440\u0438\u043a\u043b\u0435\u0438\u0432\u0430\u0439\u0442\u0435 \u0432\u0441\u0435 \u0441\u0440\u0430\u0437\u0443, \u043f\u043e\u0441\u0442\u0435\u043f\u0435\u043d\u043d\u043e \r\n\t\u043e\u0442\u0434\u0435\u043b\u044f\u0439\u0442\u0435 \u043f\u043e\u0434\u043b\u043e\u0436\u043a\u0443 \u0438 \u0440\u0430\u0437\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0443.<\/li>\r\n<\/ul>","temporary":"<a href=\"\/catalog\/naklejki\/\">\u041d\u0430\u043a\u043b\u0435\u0439\u043a\u0430 \u043d\u0430 \u043f\u043e\u043b \u0434\u0435\u0442\u0441\u043a\u0430\u044f<\/a>\r\n<a href=\"\/catalog\/naklejki\/\">\u041d\u0430\u043a\u043b\u0435\u0439\u043a\u0430 \u043d\u0430 \u043f\u043e\u043b \u0441\u043b\u0435\u0434<\/a>\r\n<a href=\"\/catalog\/naklejki\/\">\u0418\u043d\u0442\u0435\u0440\u044c\u0435\u0440\u043d\u044b\u0439 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0430 \u043d\u0430 \u043f\u043e\u043b<\/a>\r\n<a href=\"\/catalog\/naklejki\/\">\u0412\u0438\u043d\u0438\u043b\u043e\u0432\u044b\u0439 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0430 \u043d\u0430 \u043f\u043e\u043b<\/a>\r\n<a href=\"\/catalog\/naklejki\/\">\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0439 \u043d\u0430\u043a\u043b\u0435\u0439\u043a\u0430 \u043d\u0430 \u043f\u043e\u043b<\/a>\r\n<a href=\"\/catalog\/naklejki\/\">\u0428